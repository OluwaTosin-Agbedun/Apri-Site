# sharp ships prebuilt binaries and this app renders no next/image, so its
# skipped postinstall is harmless. Two settings keep it from being fatal:
strict-dep-builds=false

# pnpm 11 re-runs `pnpm install` before every `pnpm run`. That check inherits
# the skipped-build failure and aborts the build before Next.js even starts.
verify-deps-before-run=false
