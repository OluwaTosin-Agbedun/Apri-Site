# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; this example file is safe to commit because it
# contains no real credentials.

# Neon Postgres connection string (pooled endpoint recommended for serverless).
DATABASE_URL=""

# Session signing key. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# The site's own base address. Used to build sign-in links in emails, so it must
# be the real deployed origin -- a wrong value sends subscribers nowhere.
APP_URL=""

# Papermark REST API. Server-side only -- never prefix these NEXT_PUBLIC_,
# which would compile them into the browser bundle.
#
# The token identifies the team, so no team id is needed. PAPERMARK_TEAM_ID is
# kept only because older deployments may still set it; nothing reads it.
PAPERMARK_API_TOKEN=""
# Base URL from Papermark's OpenAPI document. Override only if self-hosted.
# PAPERMARK_API_BASE="https://api.papermark.com"
# Optional hostname used by APRI's Papermark Business custom-domain links.
# PAPERMARK_CUSTOM_DOMAIN="briefings.example.org"
# Folder ID for the Papermark folder named exactly "07 Open Editions".
PAPERMARK_OPEN_EDITIONS_FOLDER_ID=""

# Authorises the scheduled jobs at /api/cron/*. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Without it those routes answer 503 and never run.
CRON_SECRET=""

# Whether documents carry a per-person watermark. Off, because Papermark's
# dynamic watermark is not on the current plan -- and claiming a watermark we do
# not apply would be a promise to subscribers that we cannot keep.
#
# Set to "true" and redeploy once the plan supports it. Every mention of
# watermarking on the site and in the emails follows this one value, and the
# link-minting call only asks for a watermark when it is on.
#
# Server-side only. Never NEXT_PUBLIC_: the browser cannot read this, and a
# client bundle would silently treat it as false.
WATERMARKING_ENABLED="false"

# Signs Papermark's view webhooks. While it is unset, /api/papermark/webhook
# answers 503 rather than accepting unsigned events.
PAPERMARK_WEBHOOK_SECRET=""

# Resend email. Server-side only -- never prefix these NEXT_PUBLIC_.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
RESEND_FROM_EMAIL=""
SUBSCRIBER_FROM_EMAIL=""
BRIEFING_FROM_EMAIL=""
BRIEFING_MANAGER_EMAIL=""

# Shows the "Subscriber sign in" link in the site header.
#
# NEXT_PUBLIC_ values are compiled into the browser bundle, so this must stay a
# plain feature flag and never hold anything secret. The portal routes are
# protected by the session cookie regardless of this flag: turning it on only
# reveals the entrance, it does not grant access.
NEXT_PUBLIC_SUBSCRIBER_PORTAL_ENABLED="false"
